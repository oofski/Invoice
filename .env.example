# =====================================================================
# InvoiceIQ — Environment variables (Brief §11)
# Copy to .env.local and fill in. NEVER commit real secrets.
# =====================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # Server-side only — NEVER expose to client

# --- AWS Textract ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=                    # Get from console.anthropic.com (model: claude-sonnet-4-6)

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=invoices@yourdomain.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Internal ---
# Optional shared secret for server-to-server calls to /api/invoices/process.
PROCESS_SECRET=
