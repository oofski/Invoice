{
  "name": "invoiceiq-desktop",
  "private": true,
  "version": "1.9.9",
  "description": "InvoiceIQ desktop AP automation app",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:renderer": "npm --prefix renderer install && npm --prefix renderer run build",
    "dist": "npm run build:renderer && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build:renderer && electron-builder --win dir --publish never",
    "release": "npm run build:renderer && electron-builder --win nsis --publish always",
    "release:mac": "npm run build:renderer && electron-builder --mac dmg --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33",
    "electron-builder": "^25"
  },
  "build": {
    "appId": "com.invoiceiq.desktop",
    "productName": "EBG - Invoices and Credit Cards",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EBG - Invoices and Credit Cards",
      "artifactName": "EBG-Invoices-and-Credit-Cards-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "oofski",
        "repo": "Invoice",
        "releaseType": "draft"
      }
    ]
  }
}
